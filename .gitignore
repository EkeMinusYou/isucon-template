# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Local task/cache state
.task/
raw/
/raw

# Temporary files written while saving conversation logs
/docs/conversation/.*.md.tmp

# Contest application build artifacts
webapp/go/default.pgo

# nginx dynamic module build artifacts
/nginx/modules/*.so

# Tool build artifacts
/tools/bench-output/bench-output
/tools/portal-bench/portal-bench
/tools/analysisctl/analysisctl
/tools/deployctl/deployctl
/tools/measurectl/measurectl
/tools/measurement/cmd/proc-metrics/proc-metrics
/tools/measurement/cmd/json-metrics-collector/json-metrics-collector
/tools/measurement/cmd/mysql-metrics/mysql-metrics
/tools/nginx-backend-report/nginx-backend-report
/tools/measurement/cmd/nginx-oncpu-profiler/nginx-oncpu-profiler
/tools/user-transition-metrics/user-transition-metrics
/tools/dashboard/server/dashboardserver
/tools/measurement/cmd/sql-pool-metrics/sql-pool-metrics

# Node dependencies and browser state
node_modules/
tools/browser/.playwright-cli/

# Rebuildable state
/generated/nginx/
/generated/public/
runs/analysis.duckdb
runs/analysis.duckdb.lock

# Temporary files used for analysis rebuilds and RUN artifact collection
/runs/.analysis-rebuild-*
/runs/*/.collector-fetch-*/
/runs/*/.run-*.json

# Raw access logs are retained locally for re-digestion but not committed.
runs/*/raw/

# Local credentials
.env.local
/*.har
application_default_credentials.json

# Keep host credentials at their original destinations.
nginx/tls/
mysql/debian.cnf
etc/hosts/*/env.sh

# Python bytecode cache
__pycache__/
